{
  "name": "dsh-manage-sessions",
  "version": "0.7.0",
  "description": "DSH Web 会话管理插件：管理浮窗、批量归档/恢复/永久删除、会话强停、工作区行复制路径。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "scripts/core-patch.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "archive",
    "delete"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "link-deps": "node scripts/link-deps.mjs",
    "test": "bash scripts/run-tests.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-agent": "~0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "~0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "~0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "~0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "~0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "~0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection-cache": "~0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "~0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "prepublishOnly": "npm run build && npm test"
}
